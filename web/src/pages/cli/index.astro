---
// The complete CLI reference. There is no page05 design for this page; it is
// page05's "02 · CLI surface" section (same head, exit pills, 2.1–2.6 rows,
// spacing) carried to full, unabbreviated usage lines generated from the real
// CLI. The lede and the "Remote targets are gated" note are additions,
// listed in p5-fidelity.md under "Needs design".
import BaseLayout from "../../layouts/BaseLayout.astro";
import GroupCard from "../../components/GroupCard.astro";
import SectionHead from "../../components/SectionHead.astro";
import ExitCodes from "../../components/ExitCodes.astro";
import groups from "../../data/cli-groups.generated.json";
import { slug } from "../../lib/slug";
---
<BaseLayout
  title="CLI reference"
  current="cli"
  description="The Canon CLI reference lists every canon subcommand and its arguments, generated from the CLI's own usage text and checked for drift on every build."
>
  <section class="u-container sec">
    <SectionHead num="02" title="CLI reference" as="h1"><ExitCodes /></SectionHead>
    <p class="lede">
      This is every <code>canon</code> subcommand and its arguments, generated from
      <code>node src/cli.mjs</code>’s own usage text: <code>npm run check:cli</code> fails the build
      if the two disagree. The home page shows the condensed form of the same groups.
    </p>
    {groups.map((g) => (
      <div>
        <GroupCard
          number={g.number}
          title={g.title}
          anchor={slug(g.title)}
          summary={g.summary}
          icon={g.id}
          highlight={g.id === "remote"}
          last={g.id === "routes"}
          lines={g.lines}
        />
      </div>
    ))}
  </section>

  <section class="u-container sec sec--last">
    <SectionHead num="2.5" title="Remote targets are gated" id="remote-targets-are-gated" />
    <p class="note">
      <code>--target</code> commands never delete, change DNS, or expose a target publicly on their
      own. A real Cloudflare target is refused unless its target file sets an
      <code>https://&lt;worker&gt;.workers.dev</code> endpoint, its credential variable is set, and
      the command carries an explicit <code>--grant</code>. <code>--dry-run</code> prints the writes
      a command would send and sends nothing. Exit <code>1</code> means verification failed: Canon
      is fail-closed and never repairs a packet.
    </p>
  </section>
</BaseLayout>

<style>
  /* page05 section: padding 56px 20px 0; column; gap 6px (CLI surface).
     The last section takes page05's closing 72px (section 03). */
  .sec { padding-top: 56px; display: flex; flex-direction: column; gap: 6px; }
  .sec--last { gap: 12px; padding-bottom: 72px; }
  .lede, .note { max-width: 70ch; font-size: 15px; line-height: 1.6; color: var(--muted); }
  .lede { padding-bottom: 6px; }
  .note { color: var(--ink-secondary); }
  .lede code, .note code {
    /* page05 inline code (Plate 1, "exits 1"): mono 12px, 1px border, radius 3.5px, 0 4px */
    font-family: var(--font-code);
    font-size: 12px;
    color: var(--code-inline-ink);
    background: var(--code-inline-bg);
    border: 1px solid var(--code-inline-border);
    border-radius: 3.5px;
    padding: 0 4px;
  }
</style>
