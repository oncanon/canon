---
import Lockup from "./brand/Lockup.astro";
import Search from "./Search.astro";
import { BASE } from "../lib/base";

interface Props {
  current?: "guide" | "cli" | "schemas" | "canon-app";
}
const { current }: Props = Astro.props;
// "Canon — Identity" (2.1 rename spec) is authoritative for this list: Guide,
// CLI, Schemas, Canon.app. Page 5's literal render also shows "Formats" (now
// Schemas, renamed below) and a "Routes" link the identity spec drops — see
// p5-fidelity.md for the conflict. Routes & caching stays on-page, just not
// as a top-level nav item.
const links = [
  { id: "guide", label: "Guide", href: `${BASE}guide/` },
  { id: "cli", label: "CLI", href: `${BASE}cli/` },
  { id: "schemas", label: "Schemas", href: `${BASE}schemas/` },
  { id: "canon-app", label: "Canon.app", href: `${BASE}canon-app/` },
] as const;
---

<header class="nav">
  <div class="nav__row">
    <a class="nav__brand" href={BASE}>
      <!-- identity-v2 "In place · Docs" nav: UI lockup, word 22px (symbol 22px). -->
      <Lockup variant="ui" surface="chrome" wordSize="22px" />
      <span class="nav__badge">docs</span>
    </a>
    <nav class="nav__links" aria-label="Docs">
      {links.map((l) => (
        <a href={l.href} class="nav__link" aria-current={current === l.id ? "page" : undefined}>
          {l.label}
        </a>
      ))}
    </nav>
    <Search />
  </div>
</header>

<style>
  .nav {
    /* page05: the bar is always dark (#0f172a) with light text, independent of
       the page's own light/dark mode. */
    --ink: #0f172a;
    --paper: #f4f6f9;
    position: sticky;
    top: 0;
    z-index: 20;
    background: var(--ink);
    color: #f1f5f9;
    line-height: normal;
  }
  .nav__row {
    /* page05 nav row: padding 10px 20px; flex-wrap; gap 10px 28px;
       align-items center; justify-content space-between (brand · links ·
       search, so the links sit in the middle of the bar);
       border-bottom 1px #293548 on the row itself. */
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 10px 28px;
    /* The row carries its own 20px side padding (not .u-container's inset width)
       so the bottom rule spans the full bar up to 82rem, as on page05. */
    box-sizing: border-box;
    max-width: 82rem;
    margin-inline: auto;
    padding: 10px 20px;
    border-bottom: 1px solid #293548;
  }
  .nav__brand {
    /* page05: brand group gap 12px. */
    display: inline-flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    color: var(--paper);
  }
  .nav__badge {
    /* page05: mono 700 11px #93c5fd on #172554, 1px #1e3a8a, radius 3.5px, 1px 6px. */
    font-family: var(--font-code);
    font-weight: 700;
    font-size: 11px;
    line-height: normal;
    color: #93c5fd;
    background: #172554;
    border: 1px solid #1e3a8a;
    border-radius: 3.5px;
    padding: 1px 6px;
  }
  .nav__links {
    /* page05: gap 2px 24px; 14px / 500. */
    display: flex;
    flex-wrap: wrap;
    gap: 2px 24px;
    font-size: 14px;
    font-weight: 500;
  }
  .nav__link {
    text-decoration: none;
    color: #e2e8f0;
    padding-block: 12px;
    box-shadow: inset 0 -2px 0 transparent;
  }
  .nav__link:hover { color: var(--paper); }
  .nav__link[aria-current="page"] {
    color: #ffffff;
    box-shadow: inset 0 -2px 0 #60a5fa;
  }
  /* No mobile override: page05 has none. At 390 its row simply wraps:
     brand, then the links, then search (the nav is ~148px tall there). */
</style>

<script>
  // The sticky bar is 62px on one row but wraps to ~148px on a phone.
  // Publish its real height so anchor jumps (scroll-padding-top in
  // global.css) land below it at every width.
  const nav = document.querySelector<HTMLElement>("header.nav");
  if (nav) {
    const set = () => document.documentElement.style.setProperty("--nav-h", `${nav.offsetHeight}px`);
    new ResizeObserver(set).observe(nav);
    set();
  }
</script>
