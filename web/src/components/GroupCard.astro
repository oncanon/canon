---
interface Props {
  number: string;
  title: string;
  summary: string;
  icon?: keyof typeof ICONS;
  highlight?: boolean;
  /** Anchor id for the title (search links sections to it). */
  anchor?: string;
  last?: boolean;
  /** Command lines. page05 sets the command words in ink and everything from
      the first argument (a token starting with <, [ or -) in #475569. */
  lines?: string[];
}
const { number, title, summary, icon, highlight = false, last = false, lines, anchor }: Props = Astro.props;

function split(line: string): [string, string] {
  const m = /(^|\s)[<\[-]/.exec(line);
  if (!m || line.startsWith("/")) return [line, ""];
  const at = m.index + m[1].length;
  return [line.slice(0, at), line.slice(at)];
}

// Argument-boundary tokens: split on spaces outside [ ] and < >, so
// "[--port <n>]" or "[--host <ip> | --tailscale]" stays one unit, and so does a
// bare flag with its value. A lone "·"
// joins the token before it, so a wrapped line never starts with a dot.
function tokens(text: string): string[] {
  const out: string[] = [];
  let cur = "", depth = 0;
  for (const ch of text.trim()) {
    if (ch === "[" || ch === "<") depth++;
    if (ch === "]" || ch === ">") depth = Math.max(0, depth - 1);
    if (ch === " " && depth === 0) { if (cur) out.push(cur); cur = ""; continue; }
    cur += ch;
  }
  if (cur) out.push(cur);
  // A flag keeps its value: "--targets <file>" is one argument.
  return out.reduce<string[]>((acc, t) => {
    const prev = acc[acc.length - 1];
    if (prev !== undefined && (t === "·" || (t.startsWith("<") && /^--[\w-]+$/.test(prev)))) {
      acc[acc.length - 1] = `${prev} ${t}`;
      return acc;
    }
    return [...acc, t];
  }, []);
}

// A usage line becomes: the command words (never broken) and the rest as
// tokens that wrap at argument boundaries, continuation lines hanging under
// the first argument. Routes have no command words: the first route is the
// head and the rest hang under the second.
function parts(line: string): { head: string; rest: string[]; muted: boolean } {
  const [cmd, args] = split(line);
  if (args) return { head: cmd.trim(), rest: tokens(args), muted: true };
  const t = tokens(line);
  return { head: t[0] ?? "", rest: t.slice(1), muted: false };
}

// Path data taken verbatim from the design's per-row glyphs (viewBox 0 0 24 24).
// "remote" strokes amber (#b45309, the svg-gate token) — every other icon
// strokes ink; that's the design's own rule, not an invented accent.
const ICONS = {
  author: { d: "M6 3 H14 L18 7 V21 H6 Z M14 3 V7 H18 M9 11 H15 M9 14 H15 M9 17 H13", linecap: "butt" },
  build: { shapes: ['<rect x="3.5" y="3.5" width="17" height="17" rx="2.8" />', '<path d="M8 12.2 L10.8 15 L16 9" />'] },
  store: { shapes: ['<path d="M3 12 L9 6 H21 V18 H9 Z" />', '<circle cx="9.5" cy="12" r="1.4" />', '<path d="M13.5 12 H18" />'] },
  serve: { d: "", shapes: ['<circle cx="12" cy="12" r="2" />', '<path d="M8 8 A5.66 5.66 0 0 0 8 16 M16 8 A5.66 5.66 0 0 1 16 16 M5 5 A9.9 9.9 0 0 0 5 19 M19 5 A9.9 9.9 0 0 1 19 19" />'], linecap: "round" },
  remote: { d: "M12 18 V5 M7 10 L12 5 L17 10 M5 21 H19", stroke: "#b45309" },
  routes: { d: "M3.5 4.5 H6.5 V7.5 H3.5 Z M3.5 10.5 H6.5 V13.5 H3.5 Z M3.5 16.5 H6.5 V19.5 H3.5 Z M10 6 H20.5 M10 12 H20.5 M10 18 H17" },
} as const;
const glyph = icon ? ICONS[icon] : undefined;
---
<article class:list={["group-card", { "group-card--highlight": highlight, "group-card--last": last }]}>
  <span class="group-card__number">{number}</span>
  <div class="group-card__label">
    {glyph && (
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke={glyph.stroke ?? "var(--ink)"} stroke-width="1.5" stroke-linejoin="round" stroke-linecap={glyph.linecap ?? "butt"} aria-hidden="true">
        {glyph.shapes
          ? glyph.shapes.map((s) => <Fragment set:html={s} />)
          : <path d={glyph.d} />}
      </svg>
    )}
    <div class="group-card__text">
      <h3 class="group-card__title" id={anchor}>{title}</h3>
      <p class="group-card__summary">{summary}</p>
    </div>
  </div>
  <div class="group-card__body">
    {lines
      ? lines.map((l) => {
          const { head, rest, muted } = parts(l);
          return (
            <code class="group-card__line">
              <span class="group-card__cmd">{head}</span>
              {rest.length > 0 && (
                <span class:list={["group-card__rest", { "group-card__args": muted }]}>
                  {rest.map((t, i) => (
                    <><span class="group-card__tok">{t.split(" ").map((w, j) => <>{j > 0 ? " " : ""}<span class="group-card__word">{w}</span></>)}</span>{i < rest.length - 1 ? " " : ""}</>
                  ))}
                </span>
              )}
            </code>
          );
        })
      : <slot />}
  </div>
</article>

<style>
  /* Every value below is page05's inline CSS for the 2.x rows. */
  .group-card {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 8px 24px;
    padding-block: 18px;
    border-bottom: 1px solid var(--line);
    line-height: normal;
  }
  .group-card--last { border-bottom: 2px solid var(--ink); }
  .group-card--highlight {
    border-left: 4px solid var(--svg-gate);
    background: var(--svg-gate-bg);
    margin-left: -20px;
    padding-left: 16px;
  }
  .group-card__number {
    flex: 0 0 52px;
    font-family: var(--font-code);
    font-size: 22px;
    font-weight: 700;
    color: var(--accent-ink);
  }
  .group-card__label {
    flex: 1 1 220px;
    display: flex;
    align-items: center;
    gap: 12px;
  }
  .group-card__text { display: flex; flex-direction: column; gap: 2px; }
  .group-card__title {
    font-size: 17px;
    font-weight: 600;
  }
  .group-card__summary {
    color: var(--muted);
    font-size: 13px;
  }
  /* page05: the gated group's description is deliberately darker (#1e293b). */
  .group-card--highlight .group-card__summary { color: var(--ink-secondary); }
  .group-card__body {
    /* page05: flex 2 1 420px; min-width 0. page05 also sets overflow-x:auto
       and nowrap, which clips the real (longer) usage lines; they wrap
       instead, at argument boundaries (see .group-card__line). */
    flex: 2 1 420px;
    min-width: 0;
  }
  .group-card__body :global(code) {
    display: block;
    font-family: var(--font-code);
    font-size: 13px;
    line-height: 1.85;
    color: var(--ink);
  }
  .group-card__body .group-card__line {
    /* Hanging indent: the command words keep their own column and every
       continuation line of the arguments starts under the first argument.
       When fewer than 28ch remain beside the command (phones), the
       arguments drop to the next line, indented 2ch. */
    display: flex;
    flex-wrap: wrap;
    column-gap: 1ch;
    padding-left: 2ch;
  }
  .group-card__cmd { flex: none; white-space: nowrap; margin-left: -2ch; }
  .group-card__rest { flex: 1 1 28ch; min-width: 0; }
  .group-card__tok {
    /* One argument is one unit: it moves to the next line whole. Only a
       group wider than the whole column (e.g. the tailscale pair) breaks
       inside, and then only at its own spaces, never at a hyphen. */
    display: inline-block;
    max-width: 100%;
  }
  .group-card__word { white-space: nowrap; }
  .group-card__args { color: var(--muted); }
</style>
